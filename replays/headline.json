          },
          {
            "evidence_id": "mex24-d47:p1:fact",
            "doc_id": "mex24-d47",
            "label": "Fact",
            "page": 1,
            "text": "Forcing another driver off the track.",
            "source_url": "https://www.fia.com/sites/default/files/decision-document/2024%20Mexico%20City%20Grand%20Prix%20-%20Infringement%20-%20Car%201%20-%20Turn%204%20Forcing%20another%20driver%20of%20the%20track%20%28corrected%29.pdf#page=1"
          },
          {
            "evidence_id": "mex24-d47:p1:infringement",
            "doc_id": "mex24-d47",
            "label": "Infringement",
            "page": 1,
            "text": "Breach of Appendix L, Chapter IV, Article 2 b) of the International Sporting Code.",
            "source_url": "https://www.fia.com/sites/default/files/decision-document/2024%20Mexico%20City%20Grand%20Prix%20-%20Infringement%20-%20Car%201%20-%20Turn%204%20Forcing%20another%20driver%20of%20the%20track%20%28corrected%29.pdf#page=1"
          },
          {
            "evidence_id": "mex24-d47:p1:decision",
            "doc_id": "mex24-d47",
            "label": "Decision",
            "page": 1,
            "text": "10 second time penalty. 2 penalty points (total of 6 for the 12 month period).",
            "source_url": "https://www.fia.com/sites/default/files/decision-document/2024%20Mexico%20City%20Grand%20Prix%20-%20Infringement%20-%20Car%201%20-%20Turn%204%20Forcing%20another%20driver%20of%20the%20track%20%28corrected%29.pdf#page=1"
          },
          {
            "evidence_id": "mex24-d47:p1:reason-2",
            "doc_id": "mex24-d47",
            "label": "Reason, sentence 2",
            "page": 1,
            "text": "Norris was attempting to overtake on the outside of Verstappen at Turn 4.",
            "source_url": "https://www.fia.com/sites/default/files/decision-document/2024%20Mexico%20City%20Grand%20Prix%20-%20Infringement%20-%20Car%201%20-%20Turn%204%20Forcing%20another%20driver%20of%20the%20track%20%28corrected%29.pdf#page=1"
          },
          {
            "evidence_id": "mex24-d47:p1:reason-3",
            "doc_id": "mex24-d47",
            "label": "Reason, sentence 3",
            "page": 1,
            "text": "Norris was ahead of Verstappen at the entry, apex and towards the exit of the turn when he started being forced off the track.",
            "source_url": "https://www.fia.com/sites/default/files/decision-document/2024%20Mexico%20City%20Grand%20Prix%20-%20Infringement%20-%20Car%201%20-%20Turn%204%20Forcing%20another%20driver%20of%20the%20track%20%28corrected%29.pdf#page=1",
            "apex_spans": [
